    "mocha": "^11.7.2",
    "mochawesome": "^7.1.4",
    "sinon": "^21.0.0",
    "supertest": "^7.1.4",
    "swagger-ui-express": "^4.6.3"
  },
  "devDependencies": {
    "@types/chai": "^5.2.2",
    "@types/sinon": "^17.0.4",
    "@types/supertest": "^6.0.3",
    "chai-exclude": "^2.1.1"
  }
